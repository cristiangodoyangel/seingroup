---
import { site } from "../data/site";

const contactItems = [
  {
    label: "Teléfono / WhatsApp",
    value: site.phone,
    href: site.whatsapp,
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.5a1 1 0 01.95.68l1.2 3.2a1 1 0 01-.25 1.05L8 9.5a14 14 0 005 5l1.57-1.4a1 1 0 011.05-.25l3.2 1.2A1 1 0 0121 15.5V18a2 2 0 01-2 2A16 16 0 013 5z" />',
  },
  {
    label: "Correo electrónico",
    value: site.email,
    href: `mailto:${site.email}`,
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.9 5.3a2 2 0 002.2 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  },
  {
    label: "Ubicación",
    value: site.location,
    href: "https://maps.google.com/?q=Antofagasta,Chile",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />',
  },
];
---

<section id="contacto" class="bg-secondary py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Mapa de Ubicación -->
    <div data-reveal class="mb-14 sm:mb-16">
      <div
        class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-4"
      >
        <div>
          <h2
            class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-primary sm:text-4xl"
          >
            Nuestra Ubicación en <span
              class="text-primary underline decoration-accent decoration-4 underline-offset-4"
              >Antofagasta</span
            >
          </h2>
        </div>
      </div>

      <div
        class="relative overflow-hidden border border-primary/15 bg-white shadow-xl"
      >
        <div class="hazard-thin absolute inset-x-0 top-0 z-10 h-1.5"></div>
        <iframe
          title="Ubicación de Sein Group en Antofagasta, Chile"
          src="https://maps.google.com/maps?q=Antofagasta,%20Chile&t=&z=13&ie=UTF8&iwloc=&output=embed"
          class="h-72 w-full border-0 sm:h-96"
          loading="lazy"
          allowfullscreen=""
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>

    <!-- Sección de Cotización y Formulario -->
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <h2
          class="font-display text-5xl font-bold uppercase leading-[0.9] tracking-tight text-primary sm:text-6xl"
        >
          Cotiza tu <span
            class="text-primary font-bold underline decoration-accent decoration-4 underline-offset-8"
            >Servicio</span
          >
        </h2>
        <p class="mt-5 max-w-md text-lg text-primary/80">
          Cuéntanos tu requerimiento y te responderemos a la brevedad.
        </p>

        <div class="mt-10 border-t border-primary/15">
          {
            contactItems.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 border-b border-primary/15 py-5 transition-colors hover:bg-primary/5 px-2 rounded-sm"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center bg-primary text-accent transition-transform group-hover:scale-105">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8"
                    set:html={item.icon}
                  />
                </span>
                <span class="flex-1">
                  <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-black/50">
                    {item.label}
                  </span>
                  <span class="mt-0.5 block font-medium text-primary text-base">
                    {item.value}
                  </span>
                </span>
                <svg
                  class="h-5 w-5 text-primary/40 transition-all group-hover:translate-x-1 group-hover:text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <form
        id="contact-form"
        data-reveal
        class="relative h-fit border border-primary/15 bg-white p-6 shadow-xl sm:p-8"
      >
        <div class="hazard-thin absolute inset-x-0 top-0 h-1.5"></div>
        <p
          class="font-mono text-xs uppercase tracking-[0.2em] text-black/50 font-semibold"
        >
          Formulario de cotización
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <label
              for="name"
              class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium"
            >
              Nombre
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="Tu nombre"
              class="w-full rounded-sm border border-black/20 bg-[#fafafa] px-4 py-2.5 text-tertiary placeholder:text-black/40 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
          <div>
            <label
              for="phone"
              class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium"
            >
              Teléfono
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="+56 9 ..."
              class="w-full rounded-sm border border-black/20 bg-[#fafafa] px-4 py-2.5 text-tertiary placeholder:text-black/40 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </div>
        </div>
        <div class="mt-4">
          <label
            for="service"
            class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium"
          >
            Servicio
          </label>
          <select
            id="service"
            name="service"
            class="w-full rounded-sm border border-black/20 bg-[#fafafa] px-4 py-2.5 text-tertiary focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          >
            <option>Mantención Preventiva</option>
            <option>Verificación Eléctrica</option>
            <option>Mantención Correctiva</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="mt-4">
          <label
            for="message"
            class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium"
          >
            Mensaje
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Describe tu requerimiento..."
            class="w-full resize-none rounded-sm border border-black/20 bg-[#fafafa] px-4 py-2.5 text-tertiary placeholder:text-black/40 focus:border-primary focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary/20"
          ></textarea>
        </div>
        <button
          type="submit"
          class="mt-6 w-full bg-accent px-6 py-3.5 font-display text-lg font-bold uppercase tracking-wide text-primary transition-all hover:bg-accent-dark active:translate-y-px shadow-md"
        >
          Enviar por WhatsApp
        </button>
        <p
          class="mt-3 text-center font-mono text-[11px] uppercase tracking-[0.15em] text-black/50"
        >
          Se abrirá WhatsApp con tu mensaje listo
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const message = [
      "Hola, quiero solicitar una cotización.",
      `Nombre: ${data.get("name")}`,
      data.get("phone") ? `Teléfono: ${data.get("phone")}` : "",
      `Servicio: ${data.get("service")}`,
      `Mensaje: ${data.get("message")}`,
    ]
      .filter(Boolean)
      .join("\n");

    window.open(
      `https://wa.me/56968520171?text=${encodeURIComponent(message)}`,
      "_blank",
      "noopener,noreferrer",
    );
  });
</script>
