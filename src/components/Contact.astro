---
import { site } from "../data/site";

const contactItems = [
  {
    label: "Teléfono / WhatsApp",
    value: site.phone,
    href: site.whatsapp,
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.5a1 1 0 01.95.68l1.2 3.2a1 1 0 01-.25 1.05L8 9.5a14 14 0 005 5l1.57-1.4a1 1 0 011.05-.25l3.2 1.2A1 1 0 0121 15.5V18a2 2 0 01-2 2A16 16 0 013 5z" />',
  },
  {
    label: "Correo electrónico",
    value: site.email,
    href: `mailto:${site.email}`,
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.9 5.3a2 2 0 002.2 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  },
  {
    label: "Ubicación",
    value: site.location,
    href: "https://maps.google.com/?q=Antofagasta,Chile",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />',
  },
];
---

<section id="contacto" class="bg-primary py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-display text-5xl font-bold uppercase leading-[0.9] tracking-tight text-white sm:text-6xl">
          Cotiza tu <span class="text-accent">mantención</span>
        </h2>
        <p class="mt-5 max-w-md text-lg text-white/70">
          Cuéntanos tu requerimiento y te responderemos a la brevedad.
        </p>

        <div class="mt-10 border-t border-white/10">
          {
            contactItems.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 border-b border-white/10 py-5 transition-colors hover:bg-white/[0.03]"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center bg-white/10 text-accent transition-colors group-hover:bg-accent group-hover:text-primary">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
                </span>
                <span class="flex-1">
                  <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-white/50">
                    {item.label}
                  </span>
                  <span class="mt-0.5 block font-medium text-white">{item.value}</span>
                </span>
                <svg class="h-5 w-5 text-white/40 transition-colors group-hover:text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <form id="contact-form" class="relative h-fit border border-white/10 bg-white p-6 shadow-xl sm:p-8">
        <div class="hazard-thin absolute inset-x-0 top-0 h-1.5"></div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-black/50 font-semibold">
          Formulario de cotización
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium">
              Nombre
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="Tu nombre"
              class="w-full rounded-sm border border-black/15 px-4 py-2.5 text-tertiary placeholder:text-black/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
            />
          </div>
          <div>
            <label for="phone" class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium">
              Teléfono
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="+56 9 ..."
              class="w-full rounded-sm border border-black/15 px-4 py-2.5 text-tertiary placeholder:text-black/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
            />
          </div>
        </div>
        <div class="mt-4">
          <label for="service" class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium">
            Servicio
          </label>
          <select
            id="service"
            name="service"
            class="w-full rounded-sm border border-black/15 bg-white px-4 py-2.5 text-tertiary focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
          >
            <option>Mantención Preventiva</option>
            <option>Verificación Eléctrica</option>
            <option>Mantención Correctiva</option>
            <option>Otro</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="message" class="mb-1 block font-mono text-xs uppercase tracking-[0.15em] text-black/70 font-medium">
            Mensaje
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            placeholder="Describe tu requerimiento..."
            class="w-full resize-none rounded-sm border border-black/15 px-4 py-2.5 text-tertiary placeholder:text-black/40 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
          ></textarea>
        </div>
        <button
          type="submit"
          class="mt-6 w-full bg-accent px-6 py-3.5 font-display text-lg font-bold uppercase tracking-wide text-primary transition-colors hover:bg-accent-dark active:translate-y-px shadow-sm"
        >
          Enviar por WhatsApp
        </button>
        <p class="mt-3 text-center font-mono text-[11px] uppercase tracking-[0.15em] text-black/50">
          Se abrirá WhatsApp con tu mensaje listo
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const message = [
      "Hola, quiero solicitar una cotización.",
      `Nombre: ${data.get("name")}`,
      data.get("phone") ? `Teléfono: ${data.get("phone")}` : "",
      `Servicio: ${data.get("service")}`,
      `Mensaje: ${data.get("message")}`,
    ]
      .filter(Boolean)
      .join("\n");

    window.open(`https://wa.me/56968520171?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
  });
</script>
