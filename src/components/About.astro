---
import { about } from "../data/site";
---

<section id="nosotros" class="bg-primary-deep py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2
          data-reveal
          class="font-display text-4xl font-bold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl"
        >
          Especialistas en mantención <span class="text-secondary"
            >eléctrica</span
          > del norte de Chile
        </h2>
      </div>
      <div class="lg:col-span-5">
        <div
          data-reveal
          class="space-y-4 text-lg leading-relaxed text-white/70"
        >
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div data-reveal class="mt-8">
          <a
            href="#contacto"
            class="inline-flex items-center justify-center bg-accent px-6 py-3 font-display text-base sm:text-lg font-bold uppercase tracking-wide text-primary transition-colors hover:bg-accent-dark"
          >
            Cotizar
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
