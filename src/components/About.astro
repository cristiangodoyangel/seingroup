---
import { about } from "../data/site";
---

<section id="nosotros" class="bg-primary py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2
          data-reveal
          class="font-display text-4xl font-bold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl"
        >
          Especialistas en mantención <span class="text-accent">eléctrica</span> del norte de
          Chile
        </h2>
      </div>
      <div class="lg:col-span-5">
        <div data-reveal class="space-y-4 text-lg leading-relaxed text-white/80">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div data-reveal class="mt-8">
          <a
            href="#contacto"
            class="inline-flex items-center gap-2 font-display text-lg font-bold uppercase tracking-wide text-accent transition-colors hover:text-white"
          >
            Cotizar
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div data-reveal class="mt-16 grid gap-px border border-white/10 bg-white/10 sm:grid-cols-3">
      {about.stats.map((stat) => (
        <div class="bg-primary-dark/80 p-8">
          <p class="font-display text-3xl font-bold uppercase tracking-tight text-accent sm:text-4xl">
            {stat.value}
          </p>
          <p class="mt-2 font-mono text-xs uppercase tracking-[0.2em] text-white/60">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
