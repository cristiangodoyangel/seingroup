---
import { services } from "../data/site";

const icons: Record<string, string> = {
  shield:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  bolt: '<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />',
  wrench:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.109l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527a1.125 1.125 0 01-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.109l.894-.149c.424-.07.765-.383.93-.781.165-.397.143-.854-.108-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z M15 12a3 3 0 11-6 0 3 3 0 016 0z" />',
};
---

<section id="servicios" class="bg-primary py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6">
      <h2
        class="font-display text-5xl font-bold uppercase leading-[0.9] tracking-tight text-white sm:text-6xl"
      >
        Servicios
      </h2>
      <span
        class="hidden font-mono text-xs uppercase tracking-[0.2em] text-white/40 sm:block"
      >
        03 unidades de servicio
      </span>
    </div>

    <div class="mt-12 border-t border-white/10">
      {
        services.map((service, i) => (
          <article
            data-reveal
            class="group grid gap-6 border-b border-white/10 py-10 transition-colors hover:bg-white/[0.03] lg:grid-cols-12 lg:items-start lg:gap-8"
          >
            <div class="flex items-center gap-4 lg:col-span-3">
              <span class="font-display text-5xl font-bold text-white/20 transition-colors group-hover:text-accent sm:text-6xl">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="flex h-12 w-12 shrink-0 items-center justify-center bg-white/10 text-accent transition-colors group-hover:bg-accent group-hover:text-primary">
                <svg
                  class="h-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.6"
                  set:html={icons[service.icon]}
                />
              </span>
            </div>

            <div class="lg:col-span-4">
              <h3 class="font-display text-2xl font-bold uppercase tracking-tight text-white">
                {service.title}
              </h3>
              <p class="mt-3 text-white/70">{service.description}</p>
            </div>

            <ul class="grid gap-2 sm:grid-cols-3 lg:col-span-5 lg:grid-cols-1">
              {service.features.map((feature) => (
                <li class="flex items-center gap-2.5 text-sm text-white/70">
                  <svg
                    class="h-3.5 w-3.5 shrink-0 text-accent"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
