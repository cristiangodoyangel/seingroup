---
import { site, nav } from "../data/site";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-primary/95 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Principal"
  >
    <a href="#inicio" class="flex items-center gap-3" aria-label={site.name}>
      <img
        src={site.logo}
        alt={site.name}
        class="h-12 sm:h-14 w-auto object-contain"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-sm px-3 py-2 font-mono text-xs uppercase tracking-[0.18em] text-white/70 transition-colors hover:bg-white/5 hover:text-accent"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="ml-3 inline-flex items-center justify-center bg-accent px-5 py-2 font-display text-base font-bold uppercase tracking-wide text-primary transition-colors hover:bg-accent-dark"
      >
        Cotizar
      </a>
    </div>

    <button
      type="button"
      id="menu-button"
      class="inline-flex items-center justify-center rounded-sm p-2 text-white/80 hover:text-accent md:hidden"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg
        id="icon-open"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="icon-close"
        class="hidden h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-primary md:hidden"
  >
    <div class="space-y-1 px-4 py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="block rounded-sm px-3 py-2 font-mono text-sm uppercase tracking-[0.18em] text-white/80 hover:bg-white/5 hover:text-accent"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="mt-2 block bg-accent px-3 py-2.5 text-center font-display text-lg font-bold uppercase tracking-wide text-primary"
      >
        Cotizar
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  button?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    button.setAttribute("aria-expanded", String(!open));
    iconOpen?.classList.toggle("hidden", !open);
    iconClose?.classList.toggle("hidden", open);
  });

  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
    }),
  );
</script>
