---
import { site } from "../data/site";
---

<section id="inicio" class="relative overflow-hidden bg-secondary">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <canvas id="energy-canvas" class="h-full w-full"></canvas>
  </div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 pt-28 pb-16 sm:px-6 lg:grid-cols-12 lg:items-center lg:gap-8 lg:px-8 lg:pt-32 lg:pb-24">
    <div class="lg:col-span-7">
      <p data-reveal class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-primary font-semibold">
        <span class="h-2 w-2 bg-accent"></span>
        Mantención eléctrica · Antofagasta
      </p>

      <h1
        data-reveal
        class="mt-6 font-display text-6xl font-bold uppercase leading-[0.9] tracking-tight text-primary sm:text-7xl lg:text-8xl"
      >
        Seguridad
        <br />
        eléctrica.
        <span class="text-primary font-bold underline decoration-accent decoration-4 underline-offset-8">Cero fallas.</span>
      </h1>

      <p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-primary/80">
        Mantención preventiva, verificación y reparación de sistemas eléctricos con foco en la
        prevención de riesgos. Antofagasta, Chile.
      </p>

      <div data-reveal class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="#contacto"
          class="inline-flex items-center justify-center gap-2 bg-accent px-8 py-4 font-display text-lg font-bold uppercase tracking-wide text-primary transition-all hover:bg-accent-dark active:translate-y-px shadow-md"
        >
          Cotizar
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#servicios"
          class="inline-flex items-center justify-center border border-primary/20 bg-white/70 backdrop-blur-xs px-8 py-4 font-display text-lg font-bold uppercase tracking-wide text-primary transition-colors hover:border-primary hover:bg-primary hover:text-white"
        >
          Ver servicios
        </a>
      </div>
    </div>

    <div data-reveal class="lg:col-span-5">
      <div class="relative border border-primary/15 bg-white p-6 shadow-xl sm:p-8">
        <div class="hazard-thin absolute inset-x-0 top-0 h-1.5"></div>

        <div class="flex items-center justify-between border-b border-black/10 pb-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-black/50">
            Sein Group · Serv. eléctricos
          </span>
          <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.2em] text-primary font-semibold">
            <span class="h-1.5 w-1.5 rounded-full bg-accent ring-2 ring-accent/40"></span>
            Operativo
          </span>
        </div>

        <div class="flex items-center justify-center py-8">
          <img
            src={site.logo}
            alt={site.name}
            width="250"
            height="63"
            class="h-auto w-full max-w-[240px]"
            loading="eager"
            decoding="async"
          />
        </div>

        <dl class="space-y-3 border-t border-black/10 pt-6 font-mono text-xs">
          <div class="flex items-center justify-between">
            <dt class="uppercase tracking-[0.2em] text-black/40">Ubicación</dt>
            <dd class="font-medium text-primary">Antofagasta, Chile</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="uppercase tracking-[0.2em] text-black/40">Teléfono</dt>
            <dd class="font-medium text-primary">{site.phone}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="uppercase tracking-[0.2em] text-black/40">Correo</dt>
            <dd class="font-medium text-primary">{site.email}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById("energy-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const section = canvas.closest("section");

    const S = 36;
    let W = 0;
    let H = 0;
    let cols = 0;
    let rows = 0;
    let energy = new Float32Array(0);
    let mouseX = -1e4;
    let mouseY = -1e4;
    let active = false;

    function resize() {
      if (!canvas || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      cols = Math.ceil(W / S) + 1;
      rows = Math.ceil(H / S) + 1;
      energy = new Float32Array(cols * rows);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function onMove(e: PointerEvent) {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      active = true;
    }
    function onLeave() {
      active = false;
    }

    function idx(c: number, r: number) {
      return r * cols + c;
    }

    function eColor(e: number) {
      const r = Math.round(7 + (248 - 7) * e);
      const g = Math.round(35 + (240 - 35) * e);
      const b = Math.round(63 + (9 - 63) * e);
      return `${r},${g},${b}`;
    }

    function drawBaseGrid() {
      if (!ctx) return;
      ctx.fillStyle = "rgba(7,35,63,0.06)";
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          ctx.fillRect(c * S, r * S, 1, 1);
        }
      }
    }

    function frame() {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";

      for (let i = 0; i < energy.length; i++) {
        const e = energy[i];
        if (e > 0.002) {
          energy[i] = e * 0.9 + (Math.random() - 0.5) * 0.02 * e;
        } else {
          energy[i] = 0;
        }
      }

      if (active) {
        const R = 150;
        const c0 = Math.max(0, Math.floor((mouseX - R) / S));
        const c1 = Math.min(cols - 1, Math.ceil((mouseX + R) / S));
        const r0 = Math.max(0, Math.floor((mouseY - R) / S));
        const r1 = Math.min(rows - 1, Math.ceil((mouseY + R) / S));
        for (let r = r0; r <= r1; r++) {
          for (let c = c0; c <= c1; c++) {
            const x = c * S;
            const y = r * S;
            const dx = x - mouseX;
            const dy = y - mouseY;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d < R) {
              const t = 1 - d / R;
              const val = t * t;
              const i = idx(c, r);
              energy[i] = Math.max(energy[i], val);
              if (Math.random() < 0.05 && c + 1 < cols) {
                energy[i + 1] = Math.max(energy[i + 1], val * 0.7);
              }
              if (Math.random() < 0.05 && r + 1 < rows) {
                energy[i + cols] = Math.max(energy[i + cols], val * 0.7);
              }
            }
          }
        }
      }

      drawBaseGrid();

      ctx.lineWidth = 1;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const e = energy[idx(c, r)];
          if (e < 0.03) continue;
          const x = c * S;
          const y = r * S;
          const col = eColor(e);
          if (c + 1 < cols) {
            const er = energy[idx(c + 1, r)];
            if (er > 0.03) {
              const a = Math.min(e, er);
              ctx.strokeStyle = `rgba(${col},${0.35 * a})`;
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(x + S, y);
              ctx.stroke();
            }
          }
          if (r + 1 < rows) {
            const ed = energy[idx(c, r + 1)];
            if (ed > 0.03) {
              const a = Math.min(e, ed);
              ctx.strokeStyle = `rgba(${col},${0.35 * a})`;
              ctx.beginPath();
              ctx.moveTo(x, y);
              ctx.lineTo(x, y + S);
              ctx.stroke();
            }
          }
        }
      }

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const e = energy[idx(c, r)];
          if (e < 0.02) continue;
          const x = c * S;
          const y = r * S;
          const col = eColor(e);
          const rad = 1 + e * 3.5;
          ctx.fillStyle = `rgba(${col},${0.25 + e * 0.75})`;
          ctx.beginPath();
          ctx.arc(x, y, rad, 0, Math.PI * 2);
          ctx.fill();
          if (e > 0.6) {
            ctx.fillStyle = "rgba(255,255,255,0.9)";
            ctx.beginPath();
            ctx.arc(x, y, 1.1, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }

      ctx.globalCompositeOperation = "source-over";
      requestAnimationFrame(frame);
    }

    function drawStatic() {
      ctx.globalCompositeOperation = "lighter";
      drawBaseGrid();
      ctx.globalCompositeOperation = "source-over";
    }

    resize();
    window.addEventListener("resize", resize);
    section?.addEventListener("pointermove", onMove);
    section?.addEventListener("pointerleave", onLeave);
    section?.addEventListener("pointerup", onLeave);

    if (reduceMotion) {
      drawStatic();
    } else {
      requestAnimationFrame(frame);
    }
  }
</script>
